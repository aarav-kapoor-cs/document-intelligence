# Copy this file to ".env" and fill in your values. Never commit the real .env.
# The double underscore __ maps to app settings (e.g. OpenAI__ApiKey -> OpenAI:ApiKey).

# --- Which AI to use: "mock" (no key), "openai", or "azure" ---
Ai__Provider=mock

# --- Database. true = Microsoft SQL Server (fill the connection below); false = local SQLite file. ---
UseSqlServer=false
ConnectionStrings__SqlServer=Server=YOUR_SERVER;Database=DocIntelligenceDb;User Id=YOUR_USERNAME;Password=YOUR_PASSWORD;TrustServerCertificate=True;

# --- OpenAI (only needed if Ai__Provider=openai) ---
OpenAI__ApiKey=YOUR_OPENAI_API_KEY
OpenAI__Model=gpt-4o-mini

# --- Azure OpenAI (only needed if Ai__Provider=azure) ---
Azure__Endpoint=YOUR_AZURE_OPENAI_ENDPOINT
Azure__ApiKey=YOUR_AZURE_OPENAI_API_KEY
Azure__Deployment=YOUR_DEPLOYMENT_NAME
Azure__ApiVersion=2024-10-21
