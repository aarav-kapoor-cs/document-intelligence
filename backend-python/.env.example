# ---------------------------------------------------------------------------
# TEMPLATE. Copy this file to ".env" (same folder), then fill in your Azure values.
#   Windows: copy .env.example .env
#   Mac/Linux: cp .env.example .env
# The real ".env" is git-ignored, so your keys are NEVER pushed to GitHub or put
# in the ZIP. This template has no secrets, so it is safe to commit.
# ---------------------------------------------------------------------------

# --- Azure OpenAI (answers your prompt + checks the document type) ---
# The base URL is your resource's v1 endpoint: it ends with /openai/v1 and
# needs no api-version.
AZURE_OPENAI_BASE_URL=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1
AZURE_OPENAI_KEY=YOUR_AZURE_OPENAI_KEY
AZURE_OPENAI_DEPLOYMENT=YOUR_DEPLOYMENT_NAME

# An embedding model deployment (text-embedding-3-small). It turns chunk text
# into the vectors Azure AI Search compares — the chat deployment above cannot
# do this. Use the DEPLOYMENT name from the Deployments blade, not the model
# name from the catalogue: a model that merely exists in your region gives an
# "unknown_model" error that explains nothing.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Only needed if the embedding model lives in a DIFFERENT Azure OpenAI resource
# than the chat model above. Leave both blank and pipeline.py uses the chat
# resource. Same v1 style — base URL ends /openai/v1, no api-version.
AZURE_OPENAI_EMBEDDING_BASE_URL=
AZURE_OPENAI_EMBEDDING_KEY=

# --- Azure Document Intelligence (the OCR that reads text from your files) ---
DOC_INTELLIGENCE_ENDPOINT=https://YOUR-RESOURCE.cognitiveservices.azure.com
DOC_INTELLIGENCE_KEY=YOUR_OCR_KEY

# --- Azure AI Search (searching across the audit report) ---
# Portal -> your Search service -> Overview for the URL, and Settings -> Keys for
# the PRIMARY ADMIN key. A query key is read-only and returns 403 on upload.
# Used only by phase1.py / pipeline.py; "python phase1.py build" creates the
# index. Nothing is created on startup, and the FastAPI app does not need these.
# Leave the endpoint as the placeholder to turn search off.
AZURE_SEARCH_ENDPOINT=https://YOUR-SEARCH-SERVICE.search.windows.net
AZURE_SEARCH_KEY=YOUR_SEARCH_ADMIN_KEY

# The index keyword_search.py writes to. hybrid_search.py uses its own
# (audit-hybrid) so the keyword-only and vector versions sit side by side and can
# be compared. Leave both as they are unless you want a second copy to experiment on.
AUDIT_SEARCH_INDEX=audit-keyword
AUDIT_HYBRID_INDEX=audit-hybrid

# The audit workbook to index. Leave blank to use the newest Audit_*.xlsx sitting
# next to phase1.py. Never commit the workbook — it holds real vendor names,
# GSTINs and invoice values.
AUDIT_XLSX=

# --- The anomaly detector ---
# Scoring happens IN-PROCESS. The logistic regression trained in Azure ML is
# exported as plain coefficients in anomaly_model.json and applied with a numpy
# dot product, so there is no endpoint billing by the hour and scikit-learn is
# never installed here. Leave blank to use anomaly_model.json next to the backend.
ANOMALY_MODEL_JSON=
# Below this many documents in a scan window, the duplicate and vendor-outlier
# checks report nothing rather than computing a median from too few invoices.
ANOMALY_MIN_CORPUS=20
# The "look at this" amount, in rupees. A business policy, not a learned number.
ANOMALY_HIGH_VALUE=1000000

# --- Azure ML (training only; the FastAPI app never reads these) ---
# Used by azureml/setup.sh and azureml/fetch_model.py. Find all three in Azure ML
# studio: click the workspace name at the top right and the panel lists them.
# There is deliberately no key here - authentication is DefaultAzureCredential,
# i.e. whoever `az login` says you are, so the one service that can hand out
# compute cannot be leaked through a config file.
AZURE_ML_SUBSCRIPTION_ID=
AZURE_ML_RESOURCE_GROUP=
AZURE_ML_WORKSPACE=
AZURE_ML_MODEL_NAME=gst-anomaly-lr
# Blank means the newest version.
AZURE_ML_MODEL_VERSION=

# --- Database ---
# false = save to a local SQLite file (documents.db) — no server needed.
# true  = save to Microsoft SQL Server (office laptop). Needs the Microsoft
#         "ODBC Driver 18 for SQL Server" installed, and the database below to
#         exist (create it once in SSMS:  CREATE DATABASE DocIntelligenceDb;  ).
#         The app makes the table for you.
USE_SQL_SERVER=false

# Default: the SQL Server ON THIS LAPTOP, using your Windows login (what SSMS uses
# by default). If your instance has a name, use  Server=localhost\SQLEXPRESS  etc.
SQL_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=localhost;Database=DocIntelligenceDb;Trusted_Connection=yes;TrustServerCertificate=yes;

# Alternative: a named server with a SQL username + password (not Windows login).
# Comment out the line above and use this instead, filling in your details:
# SQL_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=YOUR_SERVER;Database=DocIntelligenceDb;Uid=YOUR_USER;Pwd=YOUR_PASSWORD;TrustServerCertificate=yes;
